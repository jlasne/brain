{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!knowledge/mcp/v|mcp/v|api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/knowledge/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/knowledge/mcp/v0",
      "destination": "https://uncommon-wolf-174.eu-west-1.convex.site/mcp/v0"
    },
    {
      "source": "/knowledge/mcp/v1",
      "destination": "https://uncommon-wolf-174.eu-west-1.convex.site/mcp/v1"
    },
    {
      "source": "/knowledge",
      "destination": "/"
    },
    {
      "source": "/knowledge/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tasu.ai"
        }
      ],
      "destination": "https://www.jeremylasne.com/knowledge/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tasu.ai"
        }
      ],
      "destination": "https://www.jeremylasne.com/knowledge/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "brain.jeremylasne.com"
        }
      ],
      "destination": "https://www.jeremylasne.com/knowledge/:path*",
      "permanent": true
    },
    {
      "source": "/knowledge/octopus",
      "destination": "/knowledge/chat?w=octopus",
      "permanent": false
    },
    {
      "source": "/knowledge/squidgy",
      "destination": "/knowledge/chat?w=squidgy",
      "permanent": false
    },
    {
      "source": "/knowledge/mcp",
      "destination": "/knowledge/doc",
      "permanent": true
    },
    {
      "source": "/knowledge/feed",
      "destination": "/knowledge/doc",
      "permanent": true
    },
    {
      "source": "/knowledge/brains",
      "destination": "/knowledge/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/knowledge/",
      "permanent": false
    }
  ]
}
