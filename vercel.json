{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!mcp/v|api/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp/v0",
      "destination": "https://uncommon-wolf-174.eu-west-1.convex.site/mcp/v0"
    },
    {
      "source": "/mcp/v1",
      "destination": "https://uncommon-wolf-174.eu-west-1.convex.site/mcp/v1"
    },
    {
      "source": "/api/public/brains",
      "destination": "https://uncommon-wolf-174.eu-west-1.convex.site/api/public/brains"
    }
  ]
}
